<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="p1" name="1. Начальное"><mxGraphModel dx="1700" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Отписыч AI. Этап 1. Начальное решение (MVP): до 50 активных пользователей в месяц&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1300" height="30" as="geometry"/></mxCell><mxCell id="gcp" value="Google Cloud · проект otpisych-ai · регион europe-west1 (Бельгия)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4285F4;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="370" y="40" width="1000" height="820" as="geometry"/></mxCell><mxCell id="user" value="Пользователь&lt;br&gt;Telegram" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="310" width="50" height="80" as="geometry"/></mxCell><mxCell id="tg" value="&lt;b&gt;Telegram Bot API&lt;/b&gt;&lt;br&gt;внешний сервис" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="300" width="150" height="90" as="geometry"/></mxCell><mxCell id="fx" value="&lt;b&gt;ExchangeRate-API&lt;/b&gt;&lt;br&gt;бесплатный план,&lt;br&gt;курс раз в день" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="470" width="150" height="80" as="geometry"/></mxCell><mxCell id="sm" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;токен бота, секрет вебхука,&lt;br&gt;ключ ExchangeRate-API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="230" height="90" as="geometry"/></mxCell><mxCell id="bot" value="&lt;b&gt;Cloud Run: otpisych-bot&lt;/b&gt;&lt;br&gt;1 vCPU, 512 MiB, min 0, max 3&lt;br&gt;вебхук Telegram и /cron&lt;br&gt;свой сервисный аккаунт,&lt;br&gt;минимальные роли" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="280" width="230" height="120" as="geometry"/></mxCell><mxCell id="sch" value="&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;напоминания (ежедневно)&lt;br&gt;курс валют (ежедневно)&lt;br&gt;AI-разбор (ежемесячно)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="480" width="230" height="100" as="geometry"/></mxCell><mxCell id="fs" value="&lt;b&gt;Firestore (Native)&lt;/b&gt;&lt;br&gt;пользователи, подписки,&lt;br&gt;курсы, разборы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="230" height="90" as="geometry"/></mxCell><mxCell id="gem" value="&lt;b&gt;Vertex AI: Gemini 3.1 Flash-Lite&lt;/b&gt;&lt;br&gt;эндпоинт ЕС (не глобальный)&lt;br&gt;разбор фраз, вопросы,&lt;br&gt;ежемесячный разбор" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="285" width="230" height="110" as="geometry"/></mxCell><mxCell id="mon" value="&lt;b&gt;Cloud Logging и Monitoring&lt;/b&gt;&lt;br&gt;логи и метрики всех сервисов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="230" height="90" as="geometry"/></mxCell><mxCell id="lane" value="Поставка кода" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="640" width="950" height="190" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;Cloud Build&lt;/b&gt;&lt;br&gt;сборка при ручном деплое&lt;br&gt;gcloud run deploy --source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="680" width="230" height="90" as="geometry"/></mxCell><mxCell id="ar" value="&lt;b&gt;Artifact Registry&lt;/b&gt;&lt;br&gt;образы контейнеров" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="680" width="230" height="90" as="geometry"/></mxCell><mxCell id="rev" value="&lt;b&gt;Новая ревизия Cloud Run&lt;/b&gt;&lt;br&gt;бот" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="680" width="230" height="90" as="geometry"/></mxCell><mxCell id="params" value="&lt;b&gt;Параметры этапа&lt;/b&gt;&lt;br&gt;Активных пользователей: 50 в месяц&lt;br&gt;Расходы с запасом 20%: &lt;b&gt;≈ $0.32 в месяц&lt;/b&gt;&lt;br&gt;(расчет в economic_model.xlsx)&lt;br&gt;&lt;br&gt;Все сервисы бессерверные: без запросов почти ничего не стоят, укладываемся в бесплатные лимиты. Платим в основном за токены Gemini." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingRight=10;spacingTop=4;rounded=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1400" y="40" width="320" height="170" as="geometry"/></mxCell><mxCell id="legend" value='&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;&lt;font color="#1967D2"&gt;■&lt;/font&gt; сервис Google Cloud&lt;br&gt;&lt;font color="#5F6368"&gt;■&lt;/font&gt; внешний сервис&lt;br&gt;&lt;font color="#137333"&gt;■&lt;/font&gt; новое или измененное на этом этапе&lt;br&gt;— поток данных и вызовов&lt;br&gt;- - - поставка кода' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingRight=10;spacingTop=4;rounded=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1400" y="230" width="320" height="120" as="geometry"/></mxCell><mxCell id="e1" value="сообщения" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;" edge="1" parent="1" source="user" target="tg"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="HTTPS-вебхук +&lt;br&gt;секретный заголовок" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="tg" target="bot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="ответы&lt;br&gt;sendMessage" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="bot" target="tg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="курс раз в день" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=0;exitY=1;entryX=1;entryY=0.3;" edge="1" parent="1" source="bot" target="fx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="секреты при запуске" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;" edge="1" parent="1" source="sm" target="bot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="HTTP-вызовы /cron" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;" edge="1" parent="1" source="sch" target="bot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="чтение и запись" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=1;exitY=0.15;entryX=0;entryY=0.75;" edge="1" parent="1" source="bot" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="AI-запросы" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bot" target="gem"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="образ" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;dashed=1;" edge="1" parent="1" source="build" target="ar"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="деплой" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;dashed=1;" edge="1" parent="1" source="ar" target="rev"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Тестирование партнерами"><mxGraphModel dx="1700" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Отписыч AI. Этап 2. Тестирование партнерами: около 1 000 активных пользователей в месяц&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1300" height="30" as="geometry"/></mxCell><mxCell id="gcp" value="Google Cloud · проект otpisych-ai · регион europe-west1 (Бельгия)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4285F4;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="370" y="40" width="1000" height="820" as="geometry"/></mxCell><mxCell id="user" value="Пользователь&lt;br&gt;Telegram" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="310" width="50" height="80" as="geometry"/></mxCell><mxCell id="tg" value="&lt;b&gt;Telegram Bot API&lt;/b&gt;&lt;br&gt;внешний сервис" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="300" width="150" height="90" as="geometry"/></mxCell><mxCell id="fx" value="&lt;b&gt;ExchangeRate-API&lt;/b&gt;&lt;br&gt;бесплатный план,&lt;br&gt;курс раз в день" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="470" width="150" height="80" as="geometry"/></mxCell><mxCell id="partners" value="&lt;b&gt;Партнеры&lt;/b&gt;&lt;br&gt;каналы о личных финансах,&lt;br&gt;ссылки с меткой партнера" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="110" y="110" width="200" height="90" as="geometry"/></mxCell><mxCell id="sm" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;токен бота, секрет вебхука,&lt;br&gt;ключ ExchangeRate-API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="230" height="90" as="geometry"/></mxCell><mxCell id="bot" value="&lt;b&gt;Cloud Run: otpisych-bot&lt;/b&gt;&lt;br&gt;1 vCPU, 512 MiB, min 0, max 5&lt;br&gt;вебхук Telegram и /cron&lt;br&gt;свой сервисный аккаунт,&lt;br&gt;минимальные роли" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="280" width="230" height="120" as="geometry"/></mxCell><mxCell id="sch" value="&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;напоминания (ежедневно)&lt;br&gt;курс валют (ежедневно)&lt;br&gt;AI-разбор (ежемесячно)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="480" width="230" height="100" as="geometry"/></mxCell><mxCell id="fs" value='&lt;b&gt;Firestore (Native)&lt;/b&gt;&lt;br&gt;пользователи, подписки,&lt;br&gt;курсы, разборы&lt;br&gt;&lt;font color="#137333"&gt;+ ежедневные копии, 7 дней&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="230" height="90" as="geometry"/></mxCell><mxCell id="gem" value="&lt;b&gt;Vertex AI: Gemini 3.1 Flash-Lite&lt;/b&gt;&lt;br&gt;эндпоинт ЕС (не глобальный)&lt;br&gt;разбор фраз, вопросы,&lt;br&gt;ежемесячный разбор" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="285" width="230" height="110" as="geometry"/></mxCell><mxCell id="tasks" value="&lt;b&gt;Cloud Tasks: review-queue&lt;/b&gt;&lt;br&gt;очередь ежемесячных разборов,&lt;br&gt;повторы и ограничение скорости" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="480" width="230" height="100" as="geometry"/></mxCell><mxCell id="mon" value='&lt;b&gt;Cloud Logging и Monitoring&lt;/b&gt;&lt;br&gt;логи и метрики всех сервисов&lt;br&gt;&lt;font color="#137333"&gt;+ uptime check, бюджет&lt;br&gt;с потолком на Vertex AI&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="230" height="90" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b&gt;Cloud Run: otpisych-worker&lt;/b&gt;&lt;br&gt;без публичного доступа&lt;br&gt;min 0, max 5&lt;br&gt;вызывается из Cloud Tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="285" width="230" height="110" as="geometry"/></mxCell><mxCell id="lane" value="Поставка кода" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="640" width="950" height="190" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;Cloud Build&lt;/b&gt;&lt;br&gt;сборка при ручном деплое&lt;br&gt;gcloud run deploy --source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="680" width="230" height="90" as="geometry"/></mxCell><mxCell id="ar" value="&lt;b&gt;Artifact Registry&lt;/b&gt;&lt;br&gt;образы контейнеров" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="680" width="230" height="90" as="geometry"/></mxCell><mxCell id="rev" value="&lt;b&gt;Новая ревизия Cloud Run&lt;/b&gt;&lt;br&gt;бот и worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="680" width="230" height="90" as="geometry"/></mxCell><mxCell id="params" value="&lt;b&gt;Параметры этапа&lt;/b&gt;&lt;br&gt;Активных пользователей: 1 000 в месяц&lt;br&gt;Расходы с запасом 20%: &lt;b&gt;≈ $6.50 в месяц&lt;/b&gt;&lt;br&gt;(расчет в economic_model.xlsx)&lt;br&gt;&lt;br&gt;Ежемесячные разборы уходят в очередь и отдельный worker, чтобы не тормозить бота и не упираться в лимиты Gemini. Появляются копии базы и контроль бюджета." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingRight=10;spacingTop=4;rounded=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1400" y="40" width="320" height="170" as="geometry"/></mxCell><mxCell id="legend" value='&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;&lt;font color="#1967D2"&gt;■&lt;/font&gt; сервис Google Cloud&lt;br&gt;&lt;font color="#5F6368"&gt;■&lt;/font&gt; внешний сервис&lt;br&gt;&lt;font color="#137333"&gt;■&lt;/font&gt; новое или измененное на этом этапе&lt;br&gt;— поток данных и вызовов&lt;br&gt;- - - поставка кода' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingRight=10;spacingTop=4;rounded=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1400" y="230" width="320" height="120" as="geometry"/></mxCell><mxCell id="e1" value="сообщения" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;" edge="1" parent="1" source="user" target="tg"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="HTTPS-вебхук +&lt;br&gt;секретный заголовок" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="tg" target="bot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="ответы&lt;br&gt;sendMessage" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="bot" target="tg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="курс раз в день" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=0;exitY=1;entryX=1;entryY=0.3;" edge="1" parent="1" source="bot" target="fx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="секреты при запуске" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;" edge="1" parent="1" source="sm" target="bot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="HTTP-вызовы /cron" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;" edge="1" parent="1" source="sch" target="bot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="чтение и запись" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=1;exitY=0.15;entryX=0;entryY=0.75;" edge="1" parent="1" source="bot" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="AI-запросы" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bot" target="gem"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="ссылки" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;" edge="1" parent="1" source="partners" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="задачи на разбор" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=1;exitY=0.9;entryX=0;entryY=0.2;" edge="1" parent="1" source="bot" target="tasks"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="доставка задач" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=1;exitY=0.2;entryX=0;entryY=0.9;" edge="1" parent="1" source="tasks" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="AI-разбор" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="worker" target="gem"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="результаты" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=0;exitY=0.1;entryX=1;entryY=0.75;" edge="1" parent="1" source="worker" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="образ" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;dashed=1;" edge="1" parent="1" source="build" target="ar"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="деплой" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;dashed=1;" edge="1" parent="1" source="ar" target="rev"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Продовое решение"><mxGraphModel dx="1700" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Отписыч AI. Этап 3. Продовое решение: около 20 000 активных пользователей в месяц&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1300" height="30" as="geometry"/></mxCell><mxCell id="gcp" value="Google Cloud · проект otpisych-ai · регион europe-west1 (Бельгия)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4285F4;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="370" y="40" width="1000" height="820" as="geometry"/></mxCell><mxCell id="user" value="Пользователь&lt;br&gt;Telegram" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="310" width="50" height="80" as="geometry"/></mxCell><mxCell id="tg" value="&lt;b&gt;Telegram Bot API&lt;/b&gt;&lt;br&gt;внешний сервис" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="300" width="150" height="90" as="geometry"/></mxCell><mxCell id="fx" value="&lt;b&gt;ExchangeRate-API&lt;/b&gt;&lt;br&gt;бесплатный план,&lt;br&gt;курс раз в день" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="470" width="150" height="80" as="geometry"/></mxCell><mxCell id="partners" value="&lt;b&gt;Партнеры&lt;/b&gt;&lt;br&gt;каналы о личных финансах,&lt;br&gt;ссылки с меткой партнера" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="110" y="110" width="200" height="90" as="geometry"/></mxCell><mxCell id="sm" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;токен бота, секрет вебхука,&lt;br&gt;ключ ExchangeRate-API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="230" height="90" as="geometry"/></mxCell><mxCell id="bot" value="&lt;b&gt;Cloud Run: otpisych-bot&lt;/b&gt;&lt;br&gt;1 vCPU, 512 MiB, &lt;b&gt;min 1&lt;/b&gt;, max 20&lt;br&gt;вебхук Telegram и /cron&lt;br&gt;свой сервисный аккаунт,&lt;br&gt;минимальные роли" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="280" width="230" height="120" as="geometry"/></mxCell><mxCell id="sch" value="&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;напоминания (ежедневно)&lt;br&gt;курс валют (ежедневно)&lt;br&gt;AI-разбор (ежемесячно)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="480" width="230" height="100" as="geometry"/></mxCell><mxCell id="fs" value='&lt;b&gt;Firestore (Native)&lt;/b&gt;&lt;br&gt;пользователи, подписки,&lt;br&gt;курсы, разборы&lt;br&gt;&lt;font color="#137333"&gt;+ копии 7 дней и PITR&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="230" height="90" as="geometry"/></mxCell><mxCell id="gem" value="&lt;b&gt;Vertex AI: Gemini 3.1 Flash-Lite&lt;/b&gt;&lt;br&gt;эндпоинт ЕС (не глобальный)&lt;br&gt;разбор фраз, вопросы,&lt;br&gt;ежемесячный разбор" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="285" width="230" height="110" as="geometry"/></mxCell><mxCell id="tasks" value="&lt;b&gt;Cloud Tasks: review-queue&lt;/b&gt;&lt;br&gt;очередь ежемесячных разборов,&lt;br&gt;повторы и ограничение скорости" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="480" width="230" height="100" as="geometry"/></mxCell><mxCell id="mon" value='&lt;b&gt;Cloud Logging и Monitoring&lt;/b&gt;&lt;br&gt;логи и метрики всех сервисов&lt;br&gt;&lt;font color="#137333"&gt;+ uptime check, бюджет&lt;br&gt;с потолком на Vertex AI,&lt;br&gt;4 условия оповещений&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="230" height="110" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b&gt;Cloud Run: otpisych-worker&lt;/b&gt;&lt;br&gt;без публичного доступа&lt;br&gt;min 0, max 10&lt;br&gt;вызывается из Cloud Tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="285" width="230" height="110" as="geometry"/></mxCell><mxCell id="lane" value="Поставка кода" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=2;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="640" width="950" height="190" as="geometry"/></mxCell><mxCell id="gh" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;репозиторий бота" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="690" width="150" height="70" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;Cloud Build&lt;/b&gt;&lt;br&gt;сборка по триггеру из GitHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="680" width="230" height="90" as="geometry"/></mxCell><mxCell id="ar" value="&lt;b&gt;Artifact Registry&lt;/b&gt;&lt;br&gt;образы контейнеров" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="680" width="230" height="90" as="geometry"/></mxCell><mxCell id="rev" value='&lt;b&gt;Новая ревизия Cloud Run&lt;/b&gt;&lt;br&gt;бот и worker,&lt;br&gt;&lt;font color="#137333"&gt;сначала 10% трафика, потом 100%&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="680" width="230" height="90" as="geometry"/></mxCell><mxCell id="params" value="&lt;b&gt;Параметры этапа&lt;/b&gt;&lt;br&gt;Активных пользователей: 20 000 в месяц&lt;br&gt;Расходы с запасом 20%: &lt;b&gt;≈ $163.03 в месяц&lt;/b&gt;&lt;br&gt;(расчет в economic_model.xlsx)&lt;br&gt;&lt;br&gt;Один экземпляр бота всегда запущен, чтобы не было холодного старта. Автоматическая поставка кода с постепенным переключением трафика, PITR и оповещения." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingRight=10;spacingTop=4;rounded=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1400" y="40" width="320" height="170" as="geometry"/></mxCell><mxCell id="legend" value='&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;&lt;font color="#1967D2"&gt;■&lt;/font&gt; сервис Google Cloud&lt;br&gt;&lt;font color="#5F6368"&gt;■&lt;/font&gt; внешний сервис&lt;br&gt;&lt;font color="#137333"&gt;■&lt;/font&gt; новое или измененное на этом этапе&lt;br&gt;— поток данных и вызовов&lt;br&gt;- - - поставка кода' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingRight=10;spacingTop=4;rounded=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1400" y="230" width="320" height="120" as="geometry"/></mxCell><mxCell id="e1" value="сообщения" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;" edge="1" parent="1" source="user" target="tg"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="HTTPS-вебхук +&lt;br&gt;секретный заголовок" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="tg" target="bot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="ответы&lt;br&gt;sendMessage" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="bot" target="tg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="курс раз в день" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=0;exitY=1;entryX=1;entryY=0.3;" edge="1" parent="1" source="bot" target="fx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="секреты при запуске" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;" edge="1" parent="1" source="sm" target="bot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="HTTP-вызовы /cron" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;" edge="1" parent="1" source="sch" target="bot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="чтение и запись" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=1;exitY=0.15;entryX=0;entryY=0.75;" edge="1" parent="1" source="bot" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="AI-запросы" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bot" target="gem"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="ссылки" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;" edge="1" parent="1" source="partners" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="задачи на разбор" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=1;exitY=0.9;entryX=0;entryY=0.2;" edge="1" parent="1" source="bot" target="tasks"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="доставка задач" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=1;exitY=0.2;entryX=0;entryY=0.9;" edge="1" parent="1" source="tasks" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="AI-разбор" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="worker" target="gem"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="результаты" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;exitX=0;exitY=0.1;entryX=1;entryY=0.75;" edge="1" parent="1" source="worker" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="push в main" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;dashed=1;" edge="1" parent="1" source="gh" target="build"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="образ" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;dashed=1;" edge="1" parent="1" source="build" target="ar"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="деплой" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3C4043;dashed=1;" edge="1" parent="1" source="ar" target="rev"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>